package templates

import "github.com/mayanksekhar/loanexitiq/go-service/loancalc"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<link rel="stylesheet" href="/static/fonts.css"/>
		<link rel="stylesheet" href="/static/style.css"/>
		<script src="/static/htmx.min.js"></script>
	</head>
	<body>
		{ children... }
		<script src="/static/app.js"></script>
	</body>
	</html>
}

templ Index(stats StatsData, bank LenderResult, chart loancalc.ChartData, lump loancalc.LumpsumResult, plan loancalc.PlanResult) {
	@Layout("LoanExitIQ") {
		<header>
			<div class="wrap brandrow">
				<div>
					<div class="brand">LOANEXIT<em>IQ</em></div>
					<div class="tag">Smartest Loan Exit Strategy Powered by Thinkwerke AI</div>
				</div>
				<div class="pill">Pilot · Gurgaon</div>
			</div>
		</header>
		<div class="tabs">
			<button type="button" id="tabCalcBtn" class="tab-btn active" onclick="showTab('calc')">Data Numeration</button>
			<button type="button" id="tabSuggBtn" class="tab-btn" onclick="showTab('suggestion')">LoanExit AI-IQ Suggestion</button>
		</div>
		<div id="calcTab" class="tab-panel">
			<div id="allInputs">
				<label>
					Loan amount (Rs)
					<span id="vAmt" class="val">Rs 3.00 Cr</span>
					<input type="range" name="amount" min="5000000" max="100000000" step="500000" value="30000000"
						oninput="document.getElementById('vAmt').textContent=fmtShort(this.value)"
						hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#calcTab"/>
				</label>
				<label>
					Interest rate (% p.a.)
					<span id="vRate" class="val">10.50%</span>
					<input type="range" name="rate" min="8" max="14" step="0.05" value="10.5"
						oninput="document.getElementById('vRate').textContent=Number(this.value).toFixed(2)+'%'"
						hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#calcTab"/>
				</label>
				<label>
					Tenure (months)
					<span id="vTen" class="val">60 months</span>
					<input type="range" name="tenure" min="24" max="240" step="6" value="60"
						oninput="document.getElementById('vTen').textContent=this.value+' months'"
						hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#calcTab"/>
				</label>
				<label>
					Exit month
					<span id="vExit" class="val">18</span>
					<input type="range" name="exit" min="3" max="230" step="1" value="18"
						oninput="document.getElementById('vExit').textContent=this.value"
						hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#calcTab"/>
				</label>
			</div>
			<div id="stats">
				@Stats(stats)
			</div>
			@EmiChart(chart)
			@BankCost(bank)
		</div>
		<div id="suggestionTabWrapper" class="tab-panel" style="display:none">
			@RecommendBanner(plan)
			@ComparisonPies(stats, plan)
			@ExitPlan(plan, bank.Name)
		</div>
		<footer>
			<b>Informational tool, not financial advice.</b> Interest rates shown are indicative assumptions, not live rate cards. Fee structures are taken from lenders' published schedules of charges, but actual terms are governed by your own sanction letter and Key Fact Statement. Business-purpose loans sanctioned before 1 Jan 2026 are not covered by RBI's prepayment charge directions, so contract clauses apply. Always request the official foreclosure statement from your lender before deciding.
		</footer>
	}
}

templ Stats(s StatsData) {
	<div class="stats">
		<div>EMI: { formatINR(s.EMI) }</div>
		<div>Interest paid so far: { formatINR(s.InterestPaid) }</div>
		<div>Principal cleared: { formatINR(s.PrincipalPaid) }</div>
		<div>Outstanding at month { itoa(s.ExitMonth) } of { itoa(s.Tenure) }: { formatINR(s.Outstanding) }</div>
	</div>
}

templ BankCost(b LenderResult) {
	<div id="bankCost" hx-swap-oob="true">
		<h2>Total cost of exit</h2>
		<div class="bank-picker">
			<label>
				Bank
				<select name="bank" hx-post="/calculate" hx-trigger="change" hx-target="#stats" hx-include="#calcTab">
					for i, l := range loancalc.Lenders {
						if i == b.SelectedIdx {
							<option value={ itoa(i) } selected>{ l.Name }</option>
						} else {
							<option value={ itoa(i) }>{ l.Name }</option>
						}
					}
				</select>
			</label>
		</div>
		<div class="cheque-hero">
			<div class="cheque-label">To close this loan today you pay</div>
			<div class="cheque-value countup" data-value={ f2(b.ChequeToday) }>{ formatINR(b.ChequeToday) }</div>
			<div class="cheque-sub">{ chequeBreakdown(b.Outstanding, b.Fee) }</div>
		</div>
		<div class="cost-split">
			<div class="cost-block">
				<div class="cost-label">Interest already paid</div>
				<div class="cost-value cost-sunk countup" data-value={ f2(b.InterestPaid) }>{ formatINR(b.InterestPaid) }</div>
				<div class="cost-sub">Money the bank has kept over { itoa(b.ExitMonth) } months. Gone whether you exit or not.</div>
			</div>
			<div class="cost-block">
				<div class="cost-label">Cost to exit today (fee + GST)</div>
				<div class="cost-value cost-fee countup" data-value={ f2(b.Fee) }>{ formatINR(b.Fee) }</div>
				if b.FeePct > 0 {
					<div class="cost-sub">{ feeBasisLine(b.FeePct, b.Outstanding) }, plus 18% GST.</div>
				} else {
					<div class="cost-sub">This lender charges no foreclosure fee at this point.</div>
				}
			</div>
		</div>
		<div class="bank-detail">
			<div>Interest rate: { ratePctStr(b.RatePct) }% p.a. (as entered above)</div>
			<div>{ totalExitLine(b.Total) }</div>
			<div class="bank-note">{ b.Note }</div>
		</div>
	</div>
}

templ ExitPlan(p loancalc.PlanResult, lenderName string) {
	<div id="lumpsumPanel" hx-swap-oob="true">
		if p.HasAction {
			<h2>If you want out of this loan</h2>
			if len(p.ExitLevers) > 0 {
				<div class="h2sub">These use { lenderName }'s own clauses to cut the charge for leaving. They cost nothing beyond the balance you already owe.</div>
				for i, lv := range p.ExitLevers {
					@LeverCard(lv, i, false)
				}
			} else {
				<div class="verdict">
					<div class="verdict-head">Cheapest way out</div>
					<div class="verdict-body">{ p.ExitVerdict }</div>
					if p.RejectedNote != "" {
						<div class="verdict-rejected">{ p.RejectedNote }</div>
					}
				</div>
				<ol class="plan">
					for j, st := range p.CloseSteps {
						<li class="plan-step">
							<div class="plan-num">{ itoa(j + 1) }</div>
							<div class="plan-body">
								<div class="plan-when">{ st.When }</div>
								<div class="plan-action">{ st.Action }</div>
								<div class="plan-why">{ st.Why }</div>
							</div>
						</li>
					}
				</ol>
			}
			if len(p.HoldLevers) > 0 {
				<h2>If you are keeping this loan running</h2>
				<div class="h2sub">These reduce the interest you pay from here on. Each needs real money, so they are ranked by how much interest every rupee you commit saves you, not by the biggest headline figure.</div>
				for i, lv := range p.HoldLevers {
					@LeverCard(lv, i, true)
				}
			}
		} else {
			<h2>Your options</h2>
			<div class="card">{ p.NoActionWhy }</div>
		}
	</div>
}

templ LeverCard(lv loancalc.Lever, i int, showRatio bool) {
	<div class="lever">
		<div class="lever-head">
			<div class="lever-rank">{ itoa(i + 1) }</div>
			<div>
				<div class="lever-title">{ lv.Title }</div>
				<div class="lever-summary">{ lv.Summary }</div>
				if lv.Requires != "" {
					<div class="lever-req">Needs: { lv.Requires }</div>
				}
			</div>
			<div class="lever-save">
				{ formatINR(lv.Saving) }<span class="lever-save-sub">saved</span>
				if showRatio && lv.PerRupee > 0 {
					<span class="lever-ratio">{ perRupeeLine(lv.PerRupee) }</span>
				}
			</div>
		</div>
		<ol class="plan">
			for j, st := range lv.Steps {
				<li class="plan-step">
					<div class="plan-num">{ itoa(j + 1) }</div>
					<div class="plan-body">
						<div class="plan-when">{ st.When }</div>
						<div class="plan-action">{ st.Action }</div>
						<div class="plan-why">{ st.Why }</div>
					</div>
				</li>
			}
		</ol>
	</div>
}


templ ComparisonPies(stats StatsData, p loancalc.PlanResult) {
	<div id="suggestionTab" hx-swap-oob="true">
		<div class="bottomline">
			<div class="bl-label">Thinkwerke AI saves you</div>
			<div class="bl-value countup" data-value={ f2(p.HeadlineSaving) }>{ formatINR(p.HeadlineSaving) }</div>
			if p.HeadlineSaving > 0 {
				<div class="bl-sub">{ p.HeadlinePath }</div>
			} else {
				<div class="bl-sub">There is no cheaper route than the one you are already on. That is the honest answer, and it is worth knowing.</div>
			}
		</div>
		<h2>Leaving this loan: the obvious way against our way</h2>
		<div class="pie-row">
			<div class="pie-card">
				<h3>If you foreclose today</h3>
				<svg viewBox="0 0 100 100" class="pie">
					<circle cx="50" cy="50" r="40" fill="none" stroke="#223041" stroke-width="18"></circle>
					<circle cx="50" cy="50" r="40" fill="none" stroke="#FF6B5E" stroke-width="18"
						stroke-dasharray={ donutSlice(p.ExitCostToday, stats.InterestPaid+p.ExitCostToday) }
						transform="rotate(-90 50 50)"></circle>
				</svg>
				<div class="pie-legend">
					<span><i style="background:#8FA0B3"></i> Interest already paid: { formatINR(stats.InterestPaid) }</span>
					<span><i style="background:#FF6B5E"></i> Exit charge today: { formatINR(p.ExitCostToday) }</span>
				</div>
				<p class="pie-explain">The grey ring is interest you have already paid, which is gone either way. The red slice is the extra charge for walking away today.</p>
			</div>
			<div class="pie-card">
				<h3>If you follow our suggestion</h3>
				<svg viewBox="0 0 100 100" class="pie">
					<circle cx="50" cy="50" r="40" fill="none" stroke="#223041" stroke-width="18"></circle>
					<circle cx="50" cy="50" r="40" fill="none" stroke="#E9B44C" stroke-width="18"
						stroke-dasharray={ donutSlice(p.SuggestedExitCost, stats.InterestPaid+p.SuggestedExitCost) }
						transform="rotate(-90 50 50)"></circle>
				</svg>
				<div class="pie-legend">
					<span><i style="background:#8FA0B3"></i> Interest already paid: { formatINR(stats.InterestPaid) }</span>
					<span><i style="background:#E9B44C"></i> Exit charge our way: { formatINR(p.SuggestedExitCost) }</span>
				</div>
				<p class="pie-explain">{ p.SuggestedExitName }. This slice can never be larger than the red one: if no clause beats closing today, then closing today is our recommendation.</p>
			</div>
		</div>
		<div class="docs-prompt">
			<div class="docs-head">These figures are modelled, not yours yet</div>
			<div>Everything above is computed from the values on the sliders. To produce the real number for your loan we need documents you already have: your <b>sanction letter</b>{ " for the actual rate and clause wording" }, your <b>annual interest and principal certificate</b> (the one issued for income tax filing), and, when you are ready to act, the bank's official <b>foreclosure statement</b>. With those three we replace every assumption with a fact and check our figure against the bank's own.</div>
		</div>
	</div>
}

templ CalcResponse(stats StatsData, bank LenderResult, chart loancalc.ChartData, lump loancalc.LumpsumResult, plan loancalc.PlanResult) {
	@Stats(stats)
	@EmiChart(chart)
	@BankCost(bank)
	@ExitPlan(plan, bank.Name)
	@RecommendBanner(plan)
	@ComparisonPies(stats, plan)
}

templ EmiChart(c loancalc.ChartData) {
	<div id="emiChart" hx-swap-oob="true">
		<h2>Where every EMI actually goes</h2>
		<div class="h2sub">Each bar is one monthly EMI, split into what the bank keeps as interest and what actually reduces what you owe. Early on, most of your money is interest. The gold line marks your exit month, everything past it is money you never end up paying.</div>
		<svg viewBox={ "0 0 " + f2(c.Width) + " " + f2(c.Height) } preserveAspectRatio="none" class="emi-svg">
			for _, b := range c.Bars {
				if b.Dimmed {
					<rect x={ f2(b.X) } y={ f2(b.PrincipalY) } width={ f2(b.Width) } height={ f2(b.PrincipalH) } fill="#58C99B" opacity="0.22"></rect>
					<rect x={ f2(b.X) } y={ f2(b.InterestY) } width={ f2(b.Width) } height={ f2(b.InterestH) } fill="#FF6B5E" opacity="0.22"></rect>
				} else {
					<rect x={ f2(b.X) } y={ f2(b.PrincipalY) } width={ f2(b.Width) } height={ f2(b.PrincipalH) } fill="#58C99B"></rect>
					<rect x={ f2(b.X) } y={ f2(b.InterestY) } width={ f2(b.Width) } height={ f2(b.InterestH) } fill="#FF6B5E"></rect>
				}
			}
			<line x1={ f2(c.MarkerX) } y1="8" x2={ f2(c.MarkerX) } y2={ f2(c.Height - 8) } stroke="#E9B44C" stroke-width="2" stroke-dasharray="5 4"></line>
			<text x={ f2(c.MarkerLabelX) } y="22" fill="#E9B44C" font-size="15" font-family="IBM Plex Mono, monospace">exit · m{ itoa(c.ExitMonth) }</text>
		</svg>
		<div class="legend">
			<span><i class="dot" style="background:#FF6B5E"></i> Interest (money the bank keeps)</span>
			<span><i class="dot" style="background:#58C99B"></i> Principal (reduces what you owe)</span>
			<span><i class="dot" style="background:#E9B44C"></i> Your exit month</span>
		</div>
		<div class="chart-callout">
			<span class="callout-lead">{ calloutLead(c.ExitMonth, c.TotalPaid, c.PrincipalCleared) }</span>
			<span class="callout-sub">{ calloutSub(c.IntPctAtExit, c.Outstanding, c.LoanAmount) }</span>
		</div>
	</div>
}
templ RecommendBanner(p loancalc.PlanResult) {
	<div id="recommendBanner" hx-swap-oob="true">
		if p.HasAction {
			<div class="rec-card rec-action">
				<div class="rec-label">Best move available</div>
				<div class="rec-headline">{ p.Best.Title }</div>
				<div class="rec-detail">{ p.Best.Summary }</div>
				<div class="rec-saving">{ formatINR(p.Best.Saving) } saved</div>
			</div>
		} else {
			<div class="rec-card">
				<div class="rec-label">Our assessment</div>
				<div class="rec-headline">No move worth making</div>
				<div class="rec-detail">{ p.NoActionWhy }</div>
			</div>
		}
	</div>
}
