package templates

import "github.com/mayanksekhar/loanexitiq/go-service/loancalc"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<link rel="stylesheet" href="/static/fonts.css"/>
		<link rel="stylesheet" href="/static/style.css"/>
		<script src="/static/htmx.min.js"></script>
	</head>
	<body>
		{ children... }
		<script>
			function fmtINR(n) {
				n = Number(n);
				var abs = Math.abs(n);
				if (abs >= 1e7) return "Rs " + (n / 1e7).toFixed(2) + " Cr";
				if (abs >= 1e5) return "Rs " + (n / 1e5).toFixed(2) + " L";
				return "Rs " + Math.round(n).toLocaleString("en-IN");
			}
			function showTab(name) {
				document.getElementById('calcTab').style.display = name === 'calc' ? '' : 'none';
				document.getElementById('suggestionTabWrapper').style.display = name === 'suggestion' ? '' : 'none';
				document.getElementById('tabCalcBtn').classList.toggle('active', name === 'calc');
				document.getElementById('tabSuggBtn').classList.toggle('active', name === 'suggestion');
			}
		</script>
	</body>
	</html>
}

templ Index(stats StatsData, bank LenderResult, strategy loancalc.StrategyResult, chart loancalc.ChartData, lump loancalc.LumpsumResult) {
	@Layout("LoanExitIQ") {
		<h1>LoanExitIQ</h1>
		<div class="tabs">
			<button type="button" id="tabCalcBtn" class="tab-btn active" onclick="showTab('calc')">Calculator</button>
			<button type="button" id="tabSuggBtn" class="tab-btn" onclick="showTab('suggestion')">LoanExit AI-IQ Suggestion</button>
		</div>
		<div id="calcTab" class="tab-panel">
			<div id="allInputs">
				<label>
					Loan amount (Rs)
					<span id="vAmt" class="val">Rs 3.00 Cr</span>
					<input type="range" name="amount" min="5000000" max="100000000" step="500000" value="30000000"
						oninput="document.getElementById('vAmt').textContent=fmtINR(this.value)"
						hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#calcTab"/>
				</label>
				<label>
					Interest rate (% p.a.)
					<span id="vRate" class="val">10.50%</span>
					<input type="range" name="rate" min="8" max="14" step="0.05" value="10.5"
						oninput="document.getElementById('vRate').textContent=Number(this.value).toFixed(2)+'%'"
						hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#calcTab"/>
				</label>
				<label>
					Tenure (months)
					<span id="vTen" class="val">60 months</span>
					<input type="range" name="tenure" min="24" max="240" step="6" value="60"
						oninput="document.getElementById('vTen').textContent=this.value+' months'"
						hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#calcTab"/>
				</label>
				<label>
					Exit month
					<span id="vExit" class="val">18</span>
					<input type="range" name="exit" min="3" max="230" step="1" value="18"
						oninput="document.getElementById('vExit').textContent=this.value"
						hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#calcTab"/>
				</label>
				<label>
					Lumpsum you can pay
					<span id="vLump" class="val">25% of balance</span>
					<input type="range" name="lumppct" min="0" max="100" step="5" value="25"
						oninput="document.getElementById(String.fromCharCode(118,76,117,109,112)).textContent=this.value+String.fromCharCode(37)+String.fromCharCode(32)+String.fromCharCode(111,102)+String.fromCharCode(32)+String.fromCharCode(98,97,108,97,110,99,101)"
						hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#calcTab"/>
				</label>
			</div>
			<div id="stats">
				@Stats(stats)
			</div>
			@EmiChart(chart)
			@BankCost(bank)
			@LumpsumPanel(lump, bank.Name)
			@StrategyPanel(strategy)
		</div>
		<div id="suggestionTabWrapper" class="tab-panel" style="display:none">
			@ComparisonPies(stats, strategy)
		</div>
	}
}

templ Stats(s StatsData) {
	<div class="stats">
		<div>EMI: { formatINR(s.EMI) }</div>
		<div>Interest paid so far: { formatINR(s.InterestPaid) }</div>
		<div>Principal cleared: { formatINR(s.PrincipalPaid) }</div>
		<div>Outstanding at month { itoa(s.ExitMonth) } of { itoa(s.Tenure) }: { formatINR(s.Outstanding) }</div>
	</div>
}

templ BankCost(b LenderResult) {
	<div id="bankCost" hx-swap-oob="true">
		<h2>Total cost of exit</h2>
		<div class="bank-picker">
			<label>
				Bank
				<select name="bank" hx-post="/calculate" hx-trigger="change" hx-target="#stats" hx-include="#calcTab">
					for i, l := range loancalc.Lenders {
						if i == b.SelectedIdx {
							<option value={ itoa(i) } selected>{ l.Name }</option>
						} else {
							<option value={ itoa(i) }>{ l.Name }</option>
						}
					}
				</select>
			</label>
		</div>
		<div class="bank-total">{ formatINR(b.Total) }</div>
		<div class="bank-detail">
			<div>Interest rate: { ratePctStr(b.RatePct) }% p.a. (assumed)</div>
			<div>Foreclosure fee at this exit month: { ratePctStr(b.FeePct) }%</div>
			<div>Interest paid over holding period: { formatINR(b.InterestPaid) }</div>
			<div>Foreclosure fee + GST: { formatINR(b.Fee) }</div>
			<div class="bank-note">{ b.Note }</div>
		</div>
	</div>
}

templ StrategyPanel(s loancalc.StrategyResult) {
	<div id="strategyPanel" hx-swap-oob="true">
		<h2>Exit strategy: { s.Title }</h2>
		<p>{ s.Mechanics }</p>
		<div class="card">
			<h3>Foreclose today</h3>
			<div>Outstanding: { formatINR(s.Outstanding) }</div>
			<div>Foreclosure fee { ratePctStr(s.FeePctNow) }%: { formatINR(s.FeeNow) }</div>
			<div>GST 18% on fee: { formatINR(s.GstNow) }</div>
			<div>Exit cost: { formatINR(s.TotalNow) }</div>
		</div>
		if s.HasStrategy {
			<div class="card">
				<h3>{ s.Title }</h3>
				for _, row := range s.Rows {
					<div>{ row.Label }: { row.Value }</div>
				}
				<div>Exit cost: { formatINR(s.TotalStrategy) }</div>
			</div>
			if s.SaveAmount >= 0 {
				<div class="save-banner">Net saving vs foreclosing today: { formatINR(s.SaveAmount) }</div>
			} else {
				<div class="save-banner-negative">This strategy costs more than foreclosing today: { formatINR(-1 * s.SaveAmount) } extra</div>
			}
		} else {
			<div class="card">No verified escape route in the exit-clause matrix for this lender.</div>
		}
	</div>
}

templ ComparisonPies(stats StatsData, strategy loancalc.StrategyResult) {
	<div id="suggestionTab" hx-swap-oob="true">
		<h2>LoanExit AI-IQ Suggestion: normal exit vs our suggestion</h2>
		<div class="pie-row">
			<div class="pie-card">
				<h3>If you foreclose today</h3>
				<svg viewBox="0 0 100 100" class="pie">
					<circle cx="50" cy="50" r="40" fill="none" stroke="#223041" stroke-width="18"></circle>
					<circle cx="50" cy="50" r="40" fill="none" stroke="#FF6B5E" stroke-width="18"
						stroke-dasharray={ donutSlice(strategy.TotalNow, stats.InterestPaid+strategy.TotalNow) }
						transform="rotate(-90 50 50)"></circle>
				</svg>
				<div class="pie-legend">
					<span><i style="background:#8FA0B3"></i> Interest paid so far: { formatINR(stats.InterestPaid) }</span>
					<span><i style="background:#FF6B5E"></i> Exit cost today: { formatINR(strategy.TotalNow) }</span>
				</div>
				<p class="pie-explain">This is what it costs to close the loan right now. The gray part of the circle is interest you've already paid the bank over time, money that's gone either way. The red part is the extra amount you'd pay today just to close the loan early: the foreclosure fee plus tax on top of it.</p>
			</div>
			if strategy.HasStrategy {
				<div class="pie-card">
					<h3>If you follow our suggestion</h3>
					<svg viewBox="0 0 100 100" class="pie">
						<circle cx="50" cy="50" r="40" fill="none" stroke="#223041" stroke-width="18"></circle>
						<circle cx="50" cy="50" r="40" fill="none" stroke="#E9B44C" stroke-width="18"
							stroke-dasharray={ donutSlice(strategy.TotalStrategy, stats.InterestPaid+strategy.TotalStrategy) }
							transform="rotate(-90 50 50)"></circle>
					</svg>
					<div class="pie-legend">
						<span><i style="background:#8FA0B3"></i> Interest paid so far: { formatINR(stats.InterestPaid) }</span>
						<span><i style="background:#E9B44C"></i> Exit cost with strategy: { formatINR(strategy.TotalStrategy) }</span>
					</div>
					<p class="pie-explain">This shows the same two amounts, but using the suggested strategy instead of closing the loan outright today. The gray part (interest already paid) doesn't change, it's already spent. Compare the size of the gold part here to the red part on the left: a smaller gold slice means the strategy genuinely reduces what you'd pay to exit. If it's the same size or larger, the strategy isn't worth it in this situation, and simply closing the loan today is the cheaper option.</p>
				</div>
			} else {
				<div class="pie-card">
					<h3>No suggested strategy</h3>
					<p>No verified escape route in the exit-clause matrix for this lender, nothing to compare against.</p>
				</div>
			}
		</div>
	</div>
}

templ CalcResponse(stats StatsData, bank LenderResult, strategy loancalc.StrategyResult, chart loancalc.ChartData, lump loancalc.LumpsumResult) {
	@Stats(stats)
	@EmiChart(chart)
	@BankCost(bank)
	@LumpsumPanel(lump, bank.Name)
	@StrategyPanel(strategy)
	@ComparisonPies(stats, strategy)
}

templ EmiChart(c loancalc.ChartData) {
	<div id="emiChart" hx-swap-oob="true">
		<h2>Where every EMI actually goes</h2>
		<div class="h2sub">Each bar is one monthly EMI, split into what the bank keeps as interest and what actually reduces what you owe. Early on, most of your money is interest. The gold line marks your exit month, everything past it is money you never end up paying.</div>
		<svg viewBox={ "0 0 " + f2(c.Width) + " " + f2(c.Height) } preserveAspectRatio="none" class="emi-svg">
			for _, b := range c.Bars {
				if b.Dimmed {
					<rect x={ f2(b.X) } y={ f2(b.PrincipalY) } width={ f2(b.Width) } height={ f2(b.PrincipalH) } fill="#58C99B" opacity="0.22"></rect>
					<rect x={ f2(b.X) } y={ f2(b.InterestY) } width={ f2(b.Width) } height={ f2(b.InterestH) } fill="#FF6B5E" opacity="0.22"></rect>
				} else {
					<rect x={ f2(b.X) } y={ f2(b.PrincipalY) } width={ f2(b.Width) } height={ f2(b.PrincipalH) } fill="#58C99B"></rect>
					<rect x={ f2(b.X) } y={ f2(b.InterestY) } width={ f2(b.Width) } height={ f2(b.InterestH) } fill="#FF6B5E"></rect>
				}
			}
			<line x1={ f2(c.MarkerX) } y1="8" x2={ f2(c.MarkerX) } y2={ f2(c.Height - 8) } stroke="#E9B44C" stroke-width="2" stroke-dasharray="5 4"></line>
			<text x={ f2(c.MarkerLabelX) } y="22" fill="#E9B44C" font-size="15" font-family="IBM Plex Mono, monospace">exit · m{ itoa(c.ExitMonth) }</text>
		</svg>
		<div class="legend">
			<span><i class="dot" style="background:#FF6B5E"></i> Interest (money the bank keeps)</span>
			<span><i class="dot" style="background:#58C99B"></i> Principal (reduces what you owe)</span>
			<span><i class="dot" style="background:#E9B44C"></i> Your exit month</span>
		</div>
		<div class="chart-callout">
			<span class="callout-lead">{ calloutLead(c.ExitMonth, c.TotalPaid, c.PrincipalCleared) }</span>
			<span class="callout-sub">{ calloutSub(c.IntPctAtExit, c.Outstanding, c.LoanAmount) }</span>
		</div>
	</div>
}

templ LumpsumPanel(r loancalc.LumpsumResult, lenderName string) {
	<div id="lumpsumPanel" hx-swap-oob="true">
		<h2>What a lumpsum payment would do</h2>
		<div class="h2sub">If you have spare money today, paying it against the principal changes what happens next. Banks usually offer two choices, and they are not worth the same.</div>
		<div class="lump-note">{ lumpFreeNote(lenderName, r.FreePct, r.FreeAllowance, r.Lumpsum, r.LumpsumIsFree) }</div>
		<div class="duel duel-3">
			<div class="card">
				<h3>Do nothing</h3>
				<div class="row"><span>Your EMI</span><b>{ formatINR(r.Baseline.EMI) }</b></div>
				<div class="row"><span>Time left</span><b>{ lumpMonthsLine(r.Baseline.Months) }</b></div>
				<div class="row"><span>Interest still to pay</span><b>{ formatINR(r.Baseline.TotalInterest) }</b></div>
				<div class="lump-explain">You carry on exactly as you are. This is the comparison point.</div>
			</div>
			<div class="card">
				<h3>Pay lumpsum, reduce your EMI</h3>
				<div class="row"><span>New EMI</span><b>{ formatINR(r.ReduceEMI.EMI) }</b></div>
				<div class="row"><span>Monthly saving</span><b>{ formatINR(r.ReduceEMI.EMIReduction) }</b></div>
				<div class="row"><span>Time left</span><b>{ lumpMonthsLine(r.ReduceEMI.Months) }</b></div>
				<div class="total"><span>Interest saved</span><span>{ formatINR(r.ReduceEMI.InterestSaved) }</span></div>
				<div class="lump-explain">Your monthly payment drops, but the loan still runs to the same end date. Easier on cash flow each month.</div>
			</div>
			<div class="card win">
				<h3>Pay lumpsum, finish sooner</h3>
				<div class="row"><span>EMI</span><b>{ formatINR(r.ReduceTenure.EMI) }</b></div>
				<div class="row"><span>Monthly saving</span><b>Nothing, EMI stays</b></div>
				<div class="row"><span>Time left</span><b>{ lumpFinishLine(r.ReduceTenure.Months, r.ReduceTenure.MonthsSaved) }</b></div>
				<div class="total"><span>Interest saved</span><span>{ formatINR(r.ReduceTenure.InterestSaved) }</span></div>
				<div class="lump-explain">You keep paying the same amount, but the loan ends earlier. You stop paying interest sooner, which is why this saves more.</div>
			</div>
		</div>
		if r.TenureAdvantage > 0 {
			<div class="save-banner">{ lumpHeadline(r.TenureAdvantage) }</div>
		}
	</div>
}
