package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title }</title>
		<script src="/static/htmx.min.js"></script>
	</head>
	<body>
		{ children... }
	</body>
	</html>
}

templ Index(stats StatsData, results []LenderResult) {
	@Layout("LoanExitIQ") {
		<h1>LoanExitIQ</h1>
		<div id="controls">
			<label>
				Loan amount (Rs)
				<input type="range" name="amount" min="5000000" max="100000000" step="500000" value="30000000"
					hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#controls"/>
			</label>
			<label>
				Interest rate (% p.a.)
				<input type="range" name="rate" min="8" max="14" step="0.05" value="10.5"
					hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#controls"/>
			</label>
			<label>
				Tenure (months)
				<input type="range" name="tenure" min="24" max="240" step="6" value="60"
					hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#controls"/>
			</label>
			<label>
				Exit month
				<input type="range" name="exit" min="3" max="230" step="1" value="18"
					hx-post="/calculate" hx-trigger="input changed delay:200ms" hx-target="#stats" hx-include="#controls"/>
			</label>
		</div>
		<div id="stats">
			@Stats(stats)
		</div>
		@Leaderboard(results)
	}
}

templ Stats(s StatsData) {
	<div class="stats">
		<div>EMI: { formatINR(s.EMI) }</div>
		<div>Interest paid so far: { formatINR(s.InterestPaid) }</div>
		<div>Principal cleared: { formatINR(s.PrincipalPaid) }</div>
		<div>Outstanding at month { itoa(s.ExitMonth) } of { itoa(s.Tenure) }: { formatINR(s.Outstanding) }</div>
	</div>
}

templ Leaderboard(results []LenderResult) {
	<div id="leaderboard" hx-swap-oob="true">
		<h2>Total cost of exit, lender by lender</h2>
		for _, r := range results {
			<div class="lender-row">
				{ r.Name } · { ratePctStr(r.RatePct) }% · { r.Note } : { formatINR(r.Total) }
				if r.IsBest {
					<span> (cheapest)</span>
				}
				if r.IsWorst {
					<span> (most expensive)</span>
				}
			</div>
		}
	</div>
}

templ CalcResponse(stats StatsData, results []LenderResult) {
	@Stats(stats)
	@Leaderboard(results)
}
